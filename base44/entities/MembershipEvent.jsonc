{
  "name": "MembershipEvent",
  "type": "object",
  "properties": {
    "membership_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "creation",
        "renewal",
        "extension",
        "freeze",
        "unfreeze",
        "correction",
        "cancellation"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Freeze start when applicable"
    },
    "expected_unfreeze_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "membership_id",
    "member_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "reception"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "reception"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "reception"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "reception"
          }
        }
      ]
    }
  }
}