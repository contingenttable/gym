{
  "name": "Membership",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_name": {
      "type": "string",
      "description": "Snapshot of plan name at creation"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "fee": {
      "type": "number",
      "description": "Snapshot of agreed (net) fee after discount"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Discount amount applied to the standard fee"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expiring_soon",
        "expired",
        "frozen",
        "cancelled"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "member_id",
    "start_date",
    "end_date",
    "fee"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "reception"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "reception"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "reception"
          }
        }
      ]
    }
  }
}